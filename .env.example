# ---- API (services/api) ----
# Supabase: Dashboard → Project Settings → Database → Connection string → URI
# (include the password; add ?sslmode=require if not already present)
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require"
API_PORT=4000
ML_SERVICE_URL=http://127.0.0.1:8000
ENERGY_BUFFER_KWH=2
BALANCE_TOLERANCE_KWH=5
DELIVERY_TOLERANCE_PCT=10
CHAIN_ENABLED=true
ANVIL_RPC_URL=http://127.0.0.1:8545
CONTRACTS_DEPLOYMENT_FILE=../../contracts/deployments/anvil.json
# Wallet auth: change the secret and set it in production; list bootstrap admins (comma-separated 0x…)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TOKEN_TTL_HOURS=72
# ADMIN_WALLETS=0xYourWalletAddress
# ALLOW_HEADER_AUTH=false
# Anvil dev keys (publicly known test keys — NEVER use on a real network)
# account #0 (deployer / operator)
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# account #1 (verifier / attestor)
ATTESTOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ---- ML (services/ml) ----
ML_PORT=8000
ML_MODEL_DIR=./models

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
