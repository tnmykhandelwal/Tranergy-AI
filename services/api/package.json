{
  "name": "@tranergy/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tranergy AI backend API — verification, matching, settlement",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx scripts/prisma.ts migrate dev --name init",
    "db:push": "tsx scripts/prisma.ts db push",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.16.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
